# Server-side only. Never use VITE_ prefixes for secrets.
PORT=4387
PUBLIC_BASE_URL=http://localhost:4387
DATA_DIR=.data
DAILY_SYNC_TIME=07:30
ADMIN_TOKEN=
# Public Umami Cloud Website ID (not an API key). Production only; blank disables tracking.
UMAMI_WEBSITE_ID=
# Set 1 only behind one trusted reverse proxy; keep 0 when directly accessible.
TRUST_PROXY_HOPS=0

# Optional TomcatTravel / account-center login. Leave all three blank to disable.
# Register a separate confidential client for each environment. Never use VITE_ here.
# Production issuer: https://auth.tomcattravel.com/realms/tomcat
# Production client ID: qdii-radar (set together with issuer and dedicated secret).
ACCOUNT_CENTER_ISSUER=
ACCOUNT_CENTER_CLIENT_ID=
ACCOUNT_CENTER_CLIENT_SECRET=

# Optional: prefer GilData for performance; otherwise use verified Eastmoney APIs.
# Use your actual MCP address and its supported transport (sse or http).
GILDATA_MCP_URL=https://api.gildata.com/mcp-servers/aidata-assistant-srv-tool
GILDATA_MCP_TOKEN=
GILDATA_MCP_TRANSPORT=http
GILDATA_MCP_AUTH=query

# Choose resend, smtp, disabled, or file (tests only).
MAIL_TRANSPORT=resend
RESEND_API_KEY=
RESEND_FROM=
MAIL_REPLY_TO=

# Optional SMTP alternative. Missing required provider settings keeps delivery disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# MAIL_TRANSPORT=file is for integration tests only; writes to DATA_DIR/mailbox.
